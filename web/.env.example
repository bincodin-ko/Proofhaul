# 마이그레이션 전용. 테이블 소유자 역할이다. 앱 런타임에서는 쓰지 않는다.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/proofhaul

# 앱 런타임. RLS를 우회할 수 없는 제한된 역할이어야 한다.
# db/migrations/001에서 만드는 proofhaul_app 역할을 쓴다.
DATABASE_URL_APP=postgres://proofhaul_app@127.0.0.1:5432/proofhaul

# 서명 이미지·첨부 파일을 둘 곳. 비우면 web/.storage 를 쓴다.
# 이 디렉터리는 어떤 경로로도 서빙하지 않는다. A5에서 비공개 버킷으로 바꾼다.
STORAGE_DIR=
